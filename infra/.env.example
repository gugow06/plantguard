# Copie para infra/.env e ajuste o que precisar.
# O docker-compose lê este arquivo automaticamente.

# --- Postgres ---
POSTGRES_USER=agrosmart
POSTGRES_PASSWORD=agrosmart
POSTGRES_DB=agrosmart

# --- App / Prisma ---
# Aponta para o serviço "postgres" interno do compose.
DATABASE_URL=postgresql://agrosmart:agrosmart@postgres:5432/agrosmart
NEXTAUTH_URL=http://localhost:3000
# Obrigatório. Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=

# Opcional — só necessário para a análise por imagem via app.
# O pipeline de streaming NÃO depende do Gemini (usa o CSV pré-classificado).
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional — envio de alertas e relatórios por e-mail.
RESEND_API_KEY=
RESEND_FROM=

# --- Streaming ---
# Intervalo entre mensagens publicadas pelo producer (ms).
STREAM_INTERVAL_MS=60000
# Total de mensagens a publicar. 0 = contínuo (use 0 para a demonstração).
STREAM_MAX_MESSAGES=10
