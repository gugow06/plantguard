# Copie para infra/.env e ajuste o que precisar.
# O docker-compose lê este arquivo automaticamente.

# --- Postgres ---
POSTGRES_USER=agrosmart
POSTGRES_PASSWORD=agrosmart
POSTGRES_DB=agrosmart

# --- App / Prisma ---
# Aponta para o serviço "postgres" interno do compose.
DATABASE_URL=postgresql://agrosmart:agrosmart@postgres:5432/agrosmart
NEXTAUTH_URL=http://localhost:3000
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=troque-este-secret

# Opcional — só necessário para usar a análise por imagem via app.
# O pipeline de streaming NÃO depende do Gemini (usa o CSV pré-classificado).
GEMINI_API_KEY=

# Login com Google (opcional). Preencha com as credenciais do Google Cloud
# Console. O redirect URI autorizado deve incluir:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envio de e-mails (alertas de doença e relatórios) via Resend.
# Sem isso o app não envia e-mails. Obtenha a chave em https://resend.com.
RESEND_API_KEY=
RESEND_FROM=PlantGuard AI <onboarding@resend.dev>

# --- Streaming ---
# Intervalo entre mensagens publicadas pelo producer (ms). 60000 = 1 minuto.
STREAM_INTERVAL_MS=60000
# Total de análises a publicar antes do producer encerrar. 0 = ilimitado.
STREAM_MAX_MESSAGES=10
